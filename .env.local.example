# ============================================================================
# EZER HRMS — marketing website
#
# Copy to .env.local and fill in. .env.local is gitignored.
#
# IMPORTANT: this is a SEPARATE Supabase project from the HRMS product. Do not
# paste the product's credentials here — the whole point of the separation is
# that a marketing deploy cannot reach the payroll database.
# ============================================================================

# ── Supabase (the marketing-site project) ──────────────────────────────────
# Project Settings → API keys.
#
# The publishable key (sb_publishable_… , formerly "anon") is browser-safe and
# is ALL the site needs to run: RLS permits anonymous INSERT on the lead,
# booking, subscriber and download tables, and permits no reads at all.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional, and server-only. The secret key (sb_secret_… , formerly
# "service_role") bypasses RLS and is needed only to READ leads — i.e. when
# you build the lead inbox in §7. Never prefix it with NEXT_PUBLIC_;
# lib/supabase/server.ts imports 'server-only' so the build fails loudly if
# anyone imports it into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string, used ONLY by `npm run db:push` to apply the
# migrations — the running site never uses it.
# Project Settings → Database → Connection string → URI, then replace
# [YOUR-PASSWORD] with the database password.
DATABASE_URL=

# ── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.ezerhrms.com
NEXT_PUBLIC_APP_URL=https://app.ezerhrms.com


# ── Spam protection ────────────────────────────────────────────────────────
# Salts the IP hash. Generate with: openssl rand -hex 32
# Changing it resets rate-limit counters; it is not a secret worth rotating.
IP_HASH_SALT=

# Cloudflare Turnstile. Leave both blank to skip the challenge entirely —
# the honeypot, time trap and rate limiter still apply.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Booking ────────────────────────────────────────────────────────────────
# Cal.com or Calendly embed URL. Leave blank and /book-a-demo falls back to
# the qualifying form alone, which still captures the lead.
NEXT_PUBLIC_CALENDAR_URL=

# ── Analytics ──────────────────────────────────────────────────────────────
# Loaded ONLY after the visitor accepts analytics cookies. Leave blank to
# disable. GA4 looks like G-XXXXXXXXXX.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=

# ── Email ──────────────────────────────────────────────────────────────────
# Two providers are supported; the first one configured wins. Without either,
# leads STILL SAVE — only the auto-reply and the sales notification are
# skipped. A mail outage never costs you a lead.
#
# Verify with:  npm run email:test you@example.com
#
# Option 1 — Resend (spec §6 recommendation)
#   resend.com → API Keys. The domain in EMAIL_FROM must be verified in
#   Resend; onboarding@resend.dev works for testing but only delivers to
#   your own Resend account's address.
RESEND_API_KEY=
EMAIL_FROM="EZER HRMS <hello@ezerhrms.com>"

# Option 2 — Gmail SMTP, the same setup the HRMS product already uses.
#   GMAIL_APP_PASSWORD is a 16-character Google App Password (requires
#   2-Step Verification), never the account password. With this provider the
#   From address is always GMAIL_USER; EMAIL_FROM is ignored.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME="EZER HRMS"

# ── Admin panel (spec §7 — internal lead management) ───────────────────────
# Generate with:  npm run admin:password
# It prints a password once and writes the hash here. The plaintext is never
# stored anywhere.
ADMIN_EMAIL=
# NOTE the ':' separators. dotenv expands $VAR inside .env values, so a hash
# written with '$' is silently truncated to "scrypt" and every login fails.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# ── Pricing ─────────────────────────────────────────────────────────────────
# Per-employee monthly rate, as a bare number. Never commit the real figure —
# this repo is public. Leave blank and the pricing page renders its
# "pricing shared on the call" state, which is the safe default.
# Also requires pricing.disclosed = true in site.config.ts to actually show.
PRICE_PER_EMPLOYEE=
